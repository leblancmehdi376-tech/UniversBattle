# Clé gratuite à obtenir sur https://rawg.io/apidocs (inscription gratuite)
RAWG_API_KEY=colle_ta_cle_ici

# Port du serveur
PORT=4000

# URL autorisée pour le CORS (ton front en dev)
CLIENT_URL=http://localhost:5173

# --- Optionnel: uniquement pour le déploiement Vercel, laisser vide en local ---
# Sans ces variables, le serveur utilise une Map en mémoire (lobbies/comptes)
# et le disque local (avatars) - suffisant pour npm run dev.

# Store Redis (Upstash, via Vercel Marketplace) pour persister lobbies/comptes
# entre les invocations serverless. Une des deux paires suffit.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Vercel Blob pour stocker les avatars (sinon écriture sur disque local)
# BLOB_READ_WRITE_TOKEN=
